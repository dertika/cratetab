# Crate Tab – Konfiguration
#
# Nach Änderungen: systemctl restart cratetab
# Alle Optionen: https://github.com/dertika/cratetab#konfiguration

CRATETAB_CLUB_NAME="Mein Verein e. V."
CRATETAB_CURRENCY="€"
CRATETAB_MIN_BALANCE="-10"
CRATETAB_DEFAULT_LANGUAGE="de"
CRATETAB_TIMEZONE="Europe/Berlin"

# Adresse und Port. Für Port 80 ohne Reverse Proxy: 0.0.0.0:80
CRATETAB_LISTEN="0.0.0.0:8080"

# Datenbank (nicht ändern, das Backup und die Updates rechnen mit diesem Pfad)
CRATETAB_DATABASE="/var/lib/cratetab/cratetab.db"

# Passwort des ersten Admins „admin“, wird nur beim allerersten Start benutzt.
# Leer lassen: Dann wird ein zufälliges Passwort erzeugt und steht im Log
# (journalctl -u cratetab | grep Passwort).
CRATETAB_ADMIN_PASSWORD=""

# Demo-Daten anlegen, solange noch keine Benutzer existieren
CRATETAB_SEED_DEMO="false"

# Wie viele Tage tägliche Backups in /var/lib/cratetab/backups aufgehoben werden
CRATETAB_BACKUP_KEEP_DAYS="30"
